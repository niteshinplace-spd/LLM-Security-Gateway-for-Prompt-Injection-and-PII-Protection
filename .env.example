# Gateway Server Settings
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
GATEWAY_TIMEOUT_SECONDS=60

# Upstream LLM (Local Ollama)
UPSTREAM_BASE_URL=http://127.0.0.1:11434
UPSTREAM_CHAT_ENDPOINT=/v1/chat/completions
UPSTREAM_DEFAULT_MODEL=llama3.2:3b
UPSTREAM_API_KEY=

# Security Controls
ALLOW_LOCALHOST=true
BLOCK_CLOUD_METADATA=true

# Logging Level
RUST_LOG=info,gateway_server=debug,gateway_core=debug
